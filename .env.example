# ───────────────────────────── Application ─────────────────────────────
APP_NAME="BTP Agent Platform"
ENVIRONMENT=development
DEBUG=true

# ─────────────────────────────── Security ──────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────── Database ──────────────────────────────
# Local dev defaults match docker-compose.yml
DATABASE_URL=postgresql+psycopg://btp:btp@localhost:5432/btp
# For zero-dependency local testing you can use SQLite instead:
# DATABASE_URL=sqlite:///./btp.db

# ──────────────────────────────── Redis ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ───────────────────────────── Object store (S3) ───────────────────────
S3_ENDPOINT_URL=
S3_BUCKET=btp-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=eu-west-3

# ─────────────────────────── LLM providers ─────────────────────────────
# Configure one or more. Leave all empty → offline mock provider (dev / tests).
# Routage par tâche (cf. SRS) ; repli automatique sur le 1er fournisseur configuré.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Default models per provider
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-pro
MISTRAL_MODEL=mistral-large-latest
DEEPSEEK_MODEL=deepseek-chat

# Transcription des notes vocales (Whisper / OpenAI) — nécessite OPENAI_API_KEY
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ──────────────────────────────── CORS ─────────────────────────────────
CORS_ORIGINS=http://localhost:3000
